# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# JWT_SECRET must be at least 32 characters (the backend refuses to start otherwise).

# --- Public HTTPS deployment (see docs/DEPLOYMENT.md) ---
# ENVIRONMENT=production
# COOKIE_SECURE=true
# CORS_ORIGINS=["https://signsense.example"]
# NEXT_PUBLIC_API_URL=https://api.signsense.example

# --- Optional TURN relay: docker compose --profile turn up ---
# TURN_SECRET=change-me
# TURN_REALM=signsense.example
# TURN_URLS=["turn:turn.signsense.example:3478","turns:turn.signsense.example:5349"]
