# Copy this file to .env and fill in real values. Never commit .env.
# Use the password you set when installing PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/signsense
CORS_ORIGINS=["http://localhost:3000"]

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters (the server refuses to start otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# Production: HTTPS only, no dev tools.
# COOKIE_SECURE=true
# Dev-only endpoints (dataset recorder, INCLUDE import). Off by default; turn on for local development only.
# ENABLE_DEV_TOOLS=true
# Phone demo on the same Wi-Fi (see README):
# CORS_ORIGIN_REGEX=https?://(192\.168|10)\.\d+\.\d+(\.\d+)?:3000
# TURN for real networks, e.g.:
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turns:turn.example.com:443?transport=tcp"],"username":"...","credential":"..."}]
# ...or short-lived TURN credentials from a coturn server running with `use-auth-secret` (recommended):
# TURN_URLS=["turn:turn.example.com:3478","turns:turn.example.com:5349"]
# TURN_SECRET=<same value as coturn's static-auth-secret>
# TURN_TTL_S=3600
# Production: ENVIRONMENT=production makes the server refuse unsafe settings (insecure cookies, dev tools on)
# and hides /docs.
# ENVIRONMENT=production
